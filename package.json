{
  "name": "patch-db",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "pkgs/*"
  ],
  "scripts": {
    "check": "bun run check:ci",
    "check:ci": "turbo run ci:syncpack ci:circular-deps ci:depcruise ci:no-direct-pg-imports tc lint test",
    "check:no-direct-pg-imports": "bun run scripts/check-no-direct-pg-imports.ts",
    "check:no-patches": "bun run scripts/check-no-patches.ts",
    "ci:audit": "bun run scripts/ci-audit.ts",
    "ci:circular-deps": "bun run scripts/check-circular-deps.ts",
    "ci:depcruise": "NODE_OPTIONS=--max-old-space-size=16384 dependency-cruise pkgs --validate .dependency-cruiser.cjs --output-type err",
    "ci:format": "prettier --check .",
    "ci:no-direct-pg-imports": "bun run scripts/check-no-direct-pg-imports.ts",
    "ci:syncpack": "syncpack lint --dependency-types prod,dev && bun run scripts/check-catalog-deps.ts && bun run scripts/check-no-patches.ts",
    "format": "sort-package-json \"package.json\" \"pkgs/*/package.json\" && prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-lingui": "catalog:",
    "eslint-plugin-naming": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "expo": "catalog:",
    "prettier": "catalog:",
    "sort-package-json": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22"
  },
  "catalog": {
    "@hono/zod-validator": "^0.7.6",
    "@sentry/cloudflare": "^10.63.0",
    "@sentry/core": "^10.63.0",
    "@sentry/react-native": "^8.17.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.9",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.25.0",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-naming": "^0.1.10",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo": "~54.0.35",
    "expo-clipboard": "~8.0.7",
    "expo-sqlite": "~16.0.10",
    "hono": "^4.12.25",
    "pg": "^8.16.3",
    "prettier": "^3.8.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "sort-package-json": "^3.6.1",
    "syncpack": "^14.3.1",
    "turbo": "^2.10.3",
    "typescript": "~6.0.3",
    "zod": "^4.3.6"
  }
}
