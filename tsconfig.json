{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["bun", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@pkgs/assert": ["./pkgs/assert/src/index.ts"],
      "@pkgs/assert/*": ["./pkgs/assert/src/*"],
      "@pkgs/async/*": ["./pkgs/async/src/*"],
      "@pkgs/attribute": ["./pkgs/attribute/src/index.ts"],
      "@pkgs/attribute/*": ["./pkgs/attribute/src/*"],
      "@pkgs/keyword": ["./pkgs/keyword/src/index.ts"],
      "@pkgs/keyword/*": ["./pkgs/keyword/src/*"],
      "@pkgs/logger": ["./pkgs/logger/src/index.ts"],
      "@pkgs/logger/*": ["./pkgs/logger/src/*"],
      "@pkgs/observability/*": ["./pkgs/observability/src/*"],
      "@pkgs/patch-db/*": ["./pkgs/patch-db/src/*"],
      "@pkgs/pub-sub/*": ["./pkgs/pub-sub/src/*"],
      "@pkgs/sql": ["./pkgs/sql/src/index.ts"],
      "@pkgs/sql/*": ["./pkgs/sql/src/*"],
      "@pkgs/sql-client/*": ["./pkgs/sql-client/src/*"],
      "@pkgs/sqlite": ["./pkgs/sqlite/src/index.ts"],
      "@pkgs/sqlite/*": ["./pkgs/sqlite/src/*"],
      "@pkgs/ts-reset": ["./pkgs/ts-reset/src/index.ts"]
    }
  },
  "include": [
    "pkgs/ts-reset/src/index.ts",
    "pkgs/assert/src/**/*.ts",
    "pkgs/async/src/**/*.ts",
    "pkgs/attribute/src/**/*.ts",
    "pkgs/keyword/src/**/*.ts",
    "pkgs/logger/src/**/*.ts",
    "pkgs/logger/src/**/*.tsx",
    "pkgs/observability/src/**/*.ts",
    "pkgs/observability/src/**/*.tsx",
    "pkgs/observability/scripts/**/*.ts",
    "pkgs/patch-db/src/**/*.ts",
    "pkgs/patch-db/src/**/*.tsx",
    "pkgs/pub-sub/src/**/*.ts",
    "pkgs/sql/src/**/*.ts",
    "pkgs/sql-client/src/**/*.ts",
    "pkgs/sql-client/src/**/*.tsx",
    "pkgs/sqlite/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "web-build"]
}
